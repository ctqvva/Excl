 //go:generate go run github.com/v2fly/v2ray-core/v5/common/errors/errorgen
 
+var amneziaReservedPrefix = []byte("EXAWG1\x00")
+
+func IsAmneziaReservedPayload(reserved []byte) bool {
+	return bytes.HasPrefix(reserved, amneziaReservedPrefix)
+}
+
+func splitAmneziaReservedPayload(reserved []byte) ([]byte, string) {
+	if !IsAmneziaReservedPayload(reserved) {
+		return reserved, ""
+	}
+	payload := reserved[len(amneziaReservedPrefix):]
+	if len(payload) == 0 {
+		return nil, ""
+	}
+	reservedLen := int(payload[0])
+	payload = payload[1:]
+	if reservedLen > len(payload) {
+		return nil, ""
+	}
+	var wireGuardReserved []byte
+	if reservedLen > 0 {
+		wireGuardReserved = payload[:reservedLen]
+	}
+	return wireGuardReserved, string(payload[reservedLen:])
+}
