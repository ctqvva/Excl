<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/test_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadlineSmall" />
    <TextView android:id="@+id/test_scope" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/test_modes" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        app:singleSelection="true" app:selectionRequired="true">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_country" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="56dp" android:text="@string/profile_test_country" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/test_speed" style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="56dp" android:text="@string/profile_test_speed" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <TextView android:id="@+id/test_note" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
    <TextView android:id="@+id/test_progress_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:accessibilityLiveRegion="polite" android:textAppearance="?attr/textAppearanceLabelLarge" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/test_progress" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        app:trackCornerRadius="4dp" app:trackThickness="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/test_list"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:gravity="end" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/test_close"
            style="?attr/materialButtonTonalStyle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/profile_test_close" />
        <com.google.android.material.button.MaterialButton android:id="@+id/test_run"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:minHeight="48dp" android:text="@string/profile_test_start" />
    </LinearLayout>
</LinearLayout>
